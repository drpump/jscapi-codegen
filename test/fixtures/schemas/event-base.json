{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/event-base",
  "title": "EventBase",
  "description": "Base type for all events in the system - a parent schema for inheritance testing",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the event occurred"
    },
    "source": {
      "type": "string",
      "description": "Source system that generated the event"
    }
  },
  "required": ["eventId", "timestamp"]
}
