{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/simple-object",
  "title": "SimpleObject",
  "description": "A simple object with basic properties for testing basic code generation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the object"
    },
    "age": {
      "type": "integer",
      "description": "The age of the person"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "The email address"
    },
    "score": {
      "type": "number",
      "description": "A numeric score"
    },
    "active": {
      "type": "boolean",
      "description": "Whether the object is active"
    }
  },
  "required": ["name", "age"]
}
