{
  "$schema": "https://json-schema.org/draft-2020-12/schema",
  "title": "ContentTypes",
  "description": "Demonstrates structural anyOf with base schema inheritance: each variant extends a shared Content interface and defines its own const value via allOf, enabling separate interfaces for the discriminator in strongly-typed languages",

  "$defs": {
    "Content": {
      "title": "Content",
      "description": "Base content interface with a discriminator field identifying the variant type",
      "type": "object",
      "properties": {
        "contentType": {
          "type": "string",
          "description": "Discriminator identifying the variant type"
        }
      },
      "required": ["contentType"]
    },

    "TextContent": {
      "title": "TextContent",
      "description": "Plain text content with a TEXT discriminator value and text property",
      "allOf": [
        { "$ref": "#/$defs/Content" },
        {
          "type": "object",
          "properties": {
            "contentType": {
              "const": "TEXT"
            }
          }
        }
      ],
      "properties": {
        "textContent": {
          "type": "string",
          "description": "The plain text content"
        }
      },
      "required": ["textContent"]
    },

    "RichContent": {
      "title": "RichContent",
      "description": "Rich text with optional formatting metadata, extends TextContent to inherit both contentType and textContent",
      "allOf": [
        { "$ref": "#/$defs/TextContent" },
        {
          "type": "object",
          "properties": {
            "contentType": {
              "const": "TEXT"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "formatting": {
              "type": "object",
              "description": "Formatting metadata for rich text",
              "properties": {
                "hasBold": {
                  "type": "boolean",
                  "description": "Whether the content uses bold formatting"
                },
                "hasLinks": {
                  "type": "boolean",
                  "description": "Whether the content contains hyperlinks"
                }
              }
            }
          }
        }
      ]
    },

    "ImageContent": {
      "title": "ImageContent",
      "description": "Binary image content with IMAGE discriminator",
      "allOf": [
        { "$ref": "#/$defs/Content" },
        {
          "type": "object",
          "properties": {
            "contentType": {
              "const": "IMAGE"
            }
          }
        }
      ],
      "properties": {
        "imageUrl": {
          "type": "string",
          "format": "uri",
          "description": "URI of the image resource"
        },
        "width": {
          "type": "integer",
          "description": "Image width in pixels"
        },
        "height": {
          "type": "integer",
          "description": "Image height in pixels"
        }
      },
      "required": ["imageUrl", "width", "height"]
    },

    "VideoContent": {
      "title": "VideoContent",
      "description": "Binary video content with VIDEO discriminator",
      "allOf": [
        { "$ref": "#/$defs/Content" },
        {
          "type": "object",
          "properties": {
            "contentType": {
              "const": "VIDEO"
            }
          }
        }
      ],
      "properties": {
        "videoUrl": {
          "type": "string",
          "format": "uri",
          "description": "URI of the video resource"
        },
        "durationSeconds": {
          "type": "integer",
          "description": "Video duration in seconds"
        }
      },
      "required": ["videoUrl", "durationSeconds"]
    }
  },

  "anyOf": [
    { "$ref": "#/$defs/TextContent" },
    { "$ref": "#/$defs/RichContent" },
    { "$ref": "#/$defs/ImageContent" },
    { "$ref": "#/$defs/VideoContent" }
  ]
}
