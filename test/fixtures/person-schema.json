{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/person.json",
    "title": "Person",
    "description": "A person with basic identifying information",
    "type": "object",
    "required": ["firstName", "lastName"],
    "additionalProperties": false,
    "properties": {
        "firstName": {
            "type": "string",
            "description": "First name of the person",
            "minLength": 1
        },
        "lastName": {
            "type": "string",
            "description": "Last name of the person",
            "minLength": 1
        },
        "email": {
            "type": "string",
            "format": "email"
        },
        "age": {
            "type": "integer",
            "minimum": 0
        },
        "salary": {
            "type": "number",
            "description": "Annual salary in USD"
        },
        "isActive": {
            "type": "boolean",
            "default": true
        }
    }
}
