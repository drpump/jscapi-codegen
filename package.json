{
    "name": "schema-driven-generator",
    "version": "0.1.0",
    "description": "JSON Schema 2020-12 driven Java/C# code generator",
    "main": "dist/main.js",
    "types": "dist/main.d.ts",
    "bin": {
        "schema-gen": "dist/main.js"
    },
    "scripts": {
        "build": "tsc",
        "dev": "ts-node src/main.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "lint": "eslint src/**/*.ts",
        "prettier": "prettier --write src/**/*.ts",
        "test:java": "node --require ts-node/register test/java/integration.test.ts"
    },
    "dependencies": {
        "@apidevtools/json-schema-ref-parser": "^11.6.2",
        "commander": "^12.0.0",
        "dedent": "^1.7.2",
        "handlebars": "^4.7.8",
        "js-yaml": "^4.1.0",
        "json-schema": "^0.4.0",
        "prettier": "^3.2.5"
    },
    "devDependencies": {
        "@types/jest": "^29.5.12",
        "@types/js-yaml": "^4.0.9",
        "@types/json-schema": "^7.0.15",
        "@types/node": "^20.11.19",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
